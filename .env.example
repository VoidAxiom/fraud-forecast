# === Database ===
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/fraud_platform
DATABASE_URL_SCORING=postgresql://scoring_user:scoring_dev_password@localhost:5432/fraud_platform
DATABASE_URL_SIMULATOR=postgresql://simulator_user:simulator_dev_password@localhost:5432/fraud_platform
DATABASE_URL_ANALYST=postgresql://analyst_user:analyst_dev_password@localhost:5432/fraud_platform

# === Postgres bootstrap (used by docker-compose) ===
POSTGRES_DB=fraud_platform
POSTGRES_USER=app
POSTGRES_PASSWORD=app_dev_password
SCORING_USER_PASSWORD=scoring_dev_password
SIMULATOR_USER_PASSWORD=simulator_dev_password
ANALYST_USER_PASSWORD=analyst_dev_password

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Archival (Phase 1) ===
ARCHIVE_BATCH_SIZE=10000
ARCHIVE_MAX_BATCHES=500
ARCHIVE_SCHEDULE_HOUR=3
ARCHIVE_SCHEDULE_TZ=Europe/London

# === Compose project (override per worktree) ===
COMPOSE_PROJECT_NAME=fraud-forecast

# === Phase 2+ placeholders ===
ORDERS_PER_SECOND=50
FRAUD_RATE=0.02
SIMULATION_TIME_COMPRESSION=60
SCORING_ENABLED=false
SCORING_SERVICE_URL=http://scoring_service:8000

# Phase 3 — chargebacks daemon
CHARGEBACK_DAEMON_INTERVAL_MIN=60
